<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DotPixelPainter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:DotPixelPainter"
    Title="DotPixelPainter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        Background="Transparent"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- メニューバー。中身は最初の描画のあとで作る（起動を軽くするため。MainWindow.Menu.cs） -->
        <MenuBar x:Name="MainMenu" Grid.Row="0" Height="32" MinHeight="0" Padding="4,0">
            <MenuBar.Resources>
                <Thickness x:Key="MenuBarItemMargin">0,2,0,2</Thickness>
            </MenuBar.Resources>
            <MenuBarItem x:Name="FileMenu" Title="{x:Bind local:Texts.MenuFile}" AccessKey="F" />
            <MenuBarItem x:Name="EditMenu" Title="{x:Bind local:Texts.MenuEdit}" AccessKey="E" />
            <MenuBarItem x:Name="ImageMenu" Title="{x:Bind local:Texts.MenuImage}" AccessKey="I" />
            <MenuBarItem x:Name="SelectMenu" Title="{x:Bind local:Texts.MenuSelect}" AccessKey="S" />
            <MenuBarItem x:Name="LayerMenu" Title="{x:Bind local:Texts.MenuLayer}" AccessKey="L" />
            <MenuBarItem x:Name="ViewMenu" Title="{x:Bind local:Texts.MenuView}" AccessKey="V" />
            <MenuBarItem x:Name="HelpMenu" Title="{x:Bind local:Texts.MenuHelp}" AccessKey="H" />
        </MenuBar>

        <!-- ツールバー（アイコン。何のボタンかはマウスを乗せると出る） -->
        <Grid
            Grid.Row="1"
            Padding="8,3"
            ColumnSpacing="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="FontIcon">
                    <Setter Property="FontSize" Value="16" />
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Padding" Value="8,6" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </Grid.Resources>
            <!-- 窓が狭いときは横にスクロールできる（右のパネルのボタンは右端に固定して隠れないようにする） -->
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Click="New_Click" AutomationProperties.Name="{x:Bind local:Texts.New}" ToolTipService.ToolTip="{x:Bind local:Texts.NewTip}"><FontIcon Glyph="&#xE8A5;" /></Button>
                    <Button Click="Open_Click" AutomationProperties.Name="{x:Bind local:Texts.Open}" ToolTipService.ToolTip="{x:Bind local:Texts.OpenTip}"><FontIcon Glyph="&#xE8E5;" /></Button>
                    <Button Click="Save_Click" AutomationProperties.Name="{x:Bind local:Texts.Save}" ToolTipService.ToolTip="{x:Bind local:Texts.SaveTip}"><FontIcon Glyph="&#xE74E;" /></Button>
                    <Button Click="SaveAs_Click" AutomationProperties.Name="{x:Bind local:Texts.SaveAs}" ToolTipService.ToolTip="{x:Bind local:Texts.SaveAsTip}"><FontIcon Glyph="&#xE792;" /></Button>
                    <AppBarSeparator />
                    <Button x:Name="UndoButton" Click="Undo_Click" IsEnabled="False" AutomationProperties.Name="{x:Bind local:Texts.Undo}" ToolTipService.ToolTip="{x:Bind local:Texts.UndoTip}"><FontIcon Glyph="&#xE7A7;" /></Button>
                    <Button x:Name="RedoButton" Click="Redo_Click" IsEnabled="False" AutomationProperties.Name="{x:Bind local:Texts.Redo}" ToolTipService.ToolTip="{x:Bind local:Texts.RedoTip}"><FontIcon Glyph="&#xE7A6;" /></Button>
                    <AppBarSeparator />
                    <Button Click="ZoomOut_Click" AutomationProperties.Name="{x:Bind local:Texts.ZoomOut}" ToolTipService.ToolTip="{x:Bind local:Texts.ZoomOut}"><FontIcon Glyph="&#xE71F;" /></Button>
                    <TextBlock x:Name="ZoomText" MinWidth="56" VerticalAlignment="Center" TextAlignment="Center" Text="800%" />
                    <Button Click="ZoomIn_Click" AutomationProperties.Name="{x:Bind local:Texts.ZoomIn}" ToolTipService.ToolTip="{x:Bind local:Texts.ZoomIn}"><FontIcon Glyph="&#xE8A3;" /></Button>
                    <AppBarSeparator />
                    <ToggleButton x:Name="GridToggle" IsChecked="True" Click="ViewOption_Click" AutomationProperties.Name="{x:Bind local:Texts.Grid}" ToolTipService.ToolTip="{x:Bind local:Texts.GridTip}"><FontIcon Glyph="&#xF0E2;" /></ToggleButton>
                    <ToggleButton x:Name="FlipToggle" Click="ViewOption_Click" AutomationProperties.Name="{x:Bind local:Texts.MirrorView}" ToolTipService.ToolTip="{x:Bind local:Texts.MirrorViewTip}"><FontIcon Glyph="&#xE8AB;" /></ToggleButton>
                    <AppBarSeparator />
                    <ToggleButton x:Name="SkinToggle" Click="SkinToggle_Click" AutomationProperties.Name="{x:Bind local:Texts.Skin}" ToolTipService.ToolTip="{x:Bind local:Texts.SkinTip}"><FontIcon Glyph="&#xE77B;" /></ToggleButton>
                </StackPanel>
            </ScrollViewer>
            <ToggleButton x:Name="SplitToggle" Grid.Column="1" Click="SplitToggle_Click" AutomationProperties.Name="{x:Bind local:Texts.SplitView}" ToolTipService.ToolTip="{x:Bind local:Texts.SplitViewTip}"><FontIcon Glyph="&#xE8B9;" /></ToggleButton>
            <ToggleButton x:Name="PanelToggle" Grid.Column="2" IsChecked="True" Click="PanelToggle_Click" AutomationProperties.Name="{x:Bind local:Texts.RightPanel}" ToolTipService.ToolTip="{x:Bind local:Texts.RightPanelTip}"><FontIcon Glyph="&#xE8A0;" /></ToggleButton>
        </Grid>

        <!-- 開いているファイルのタブ -->
        <TabView
            x:Name="Tabs"
            Grid.Row="2"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            CanDragTabs="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            SelectionChanged="Tabs_SelectionChanged" />

        <!-- ツールパネル・キャンバス・右パネル -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="232" />
            </Grid.ColumnDefinitions>

            <!-- ツール: 縦1列の細い帯。上が道具、区切り線の下が描き方 -->
            <Border
                x:Name="ToolPanel"
                Width="49"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <!-- ウィンドウが低いときはスクロールできるようにする -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto">
                    <StackPanel Padding="7,8" Spacing="3">
                        <StackPanel x:Name="ToolGrid" Spacing="3" />
                        <Rectangle Height="1" Margin="2,5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="ShapeGrid" Spacing="3" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- キャンバス。分割すると右に資料の画面が出る（MainWindow.Reference.cs。分割するまで作らない。中身はコードで作る） -->
            <Grid x:Name="CanvasArea" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RefColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <win2d:CanvasControl
                    x:Name="Canvas"
                    ClearColor="#FF2B2B2B"
                    Draw="Canvas_Draw"
                    PointerPressed="Canvas_PointerPressed"
                    PointerMoved="Canvas_PointerMoved"
                    PointerReleased="Canvas_PointerReleased"
                    PointerCaptureLost="Canvas_PointerCaptureLost"
                    PointerWheelChanged="Canvas_PointerWheelChanged" />
            </Grid>

            <Border
                x:Name="RightPanel"
                Grid.Column="2"
                Padding="12,12,0,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <!-- ウィンドウが低いときはスクロールできるようにする -->
                <!-- スクロールバーは中身の上に重なって出るので、右側にその分の余白を空ける -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="0,0,14,0">
                    <!--
                        パネル: 外側の Border（*Slot）が置き場所、内側の StackPanel（*Section）が中身。
                        切り離すと Section だけが別ウィンドウへ移り、Slot は隠れる。
                    -->
                    <Border x:Name="PreviewSlot">
                    <StackPanel x:Name="PreviewSection" Spacing="8">
                        <Grid>
                            <TextBlock x:Name="PreviewTitle" Text="{x:Bind local:Texts.Preview}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="TileToggle" Padding="6,4" Click="TileToggle_Click" ToolTipService.ToolTip="{x:Bind local:Texts.TileTip}">
                                    <FontIcon Glyph="&#xE80A;" FontSize="12" />
                                </ToggleButton>
                                <Button Padding="6,4" Click="PreviewBackground_Click" ToolTipService.ToolTip="{x:Bind local:Texts.PreviewBackgroundTip}">
                                    <FontIcon Glyph="&#xE790;" FontSize="12" />
                                </Button>
                                <Button x:Name="PreviewDetachButton" Tag="preview" Padding="6,4" Click="PanelDetach_Click">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <win2d:CanvasControl
                            x:Name="PreviewCanvas"
                            Height="140"
                            Draw="PreviewCanvas_Draw"
                            PointerPressed="PreviewCanvas_PointerPressed"
                            PointerMoved="PreviewCanvas_PointerMoved"
                            PointerReleased="PreviewCanvas_PointerReleased"
                            DoubleTapped="PreviewCanvas_DoubleTapped" />
                        <!-- 下にドラッグしてプレビューを高くする -->
                        <local:ResizeGrip
                            Height="10"
                            Margin="0,-8,0,-6"
                            Background="Transparent"
                            PointerPressed="PreviewGrip_PointerPressed"
                            PointerMoved="PreviewGrip_PointerMoved"
                            PointerReleased="PreviewGrip_PointerReleased"
                            PointerCaptureLost="PreviewGrip_PointerCaptureLost"
                            DoubleTapped="PreviewGrip_DoubleTapped"
                            ToolTipService.ToolTip="{x:Bind local:Texts.PreviewGripTip}">
                            <Rectangle Width="36" Height="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                        </local:ResizeGrip>
                        <!-- スキンモードのときだけ出す -->
                        <StackPanel x:Name="SkinOptions" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <ToggleButton x:Name="SlimToggle" Content="{x:Bind local:Texts.SlimArms}" Click="SkinOption_Click" ToolTipService.ToolTip="{x:Bind local:Texts.SlimArmsTip}" />
                            <ToggleButton x:Name="OuterToggle" Content="{x:Bind local:Texts.Outer}" IsChecked="True" Click="SkinOption_Click" ToolTipService.ToolTip="{x:Bind local:Texts.OuterTip}" />
                        </StackPanel>
                    </StackPanel>
                    </Border>

                    <Border x:Name="ColorSlot">
                    <StackPanel x:Name="ColorSection" Spacing="8">
                    <Grid>
                        <TextBlock Text="{x:Bind local:Texts.Color}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Button x:Name="ColorDetachButton" Tag="color" HorizontalAlignment="Right" Padding="6,4" Click="PanelDetach_Click">
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 色: 描画色と背景色、色コード、RGB/HSV の切り替え -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="54" Height="54">
                            <Border
                                x:Name="BackColorSwatch"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Tapped="BackColor_Tapped"
                                ToolTipService.ToolTip="{x:Bind local:Texts.BackColorTip}" />
                            <Border
                                x:Name="ForeColorSwatch"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Tapped="ForeColor_Tapped"
                                ToolTipService.ToolTip="{x:Bind local:Texts.ForeColorTip}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBox
                                x:Name="ColorHexBox"
                                FontFamily="Consolas"
                                MaxLength="9"
                                KeyDown="ColorHexBox_KeyDown"
                                LostFocus="ColorHexBox_LostFocus"
                                ToolTipService.ToolTip="{x:Bind local:Texts.HexTip}" />
                            <ToggleButton
                                x:Name="HsvToggle"
                                Content="HSV"
                                Padding="10,2"
                                Click="ColorMode_Click"
                                ToolTipService.ToolTip="{x:Bind local:Texts.ColorModeTip}" />
                        </StackPanel>
                    </Grid>

                    <!-- 色のスライダー（1枚の描画領域に4本まとめて描く） -->
                    <win2d:CanvasControl
                        x:Name="ColorBarsCanvas"
                        Height="96"
                        Draw="ColorBars_Draw"
                        PointerPressed="ColorBars_PointerPressed"
                        PointerMoved="ColorBars_PointerMoved"
                        PointerReleased="ColorBars_PointerReleased"
                        PointerCaptureLost="ColorBars_PointerCaptureLost"
                        PointerWheelChanged="ColorBars_PointerWheelChanged" />

                    <!-- ブラシ -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock x:Name="BrushSizeText" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind local:Texts.Brush1px}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="SquareBrushToggle" Content="□" Padding="8,2" IsChecked="True" Click="BrushShape_Click" ToolTipService.ToolTip="{x:Bind local:Texts.SquareTipTip}" />
                            <ToggleButton x:Name="RoundBrushToggle" Content="○" Padding="8,2" Click="BrushShape_Click" ToolTipService.ToolTip="{x:Bind local:Texts.RoundTipTip}" />
                        </StackPanel>
                    </Grid>
                    <Slider
                        x:Name="BrushSizeSlider"
                        Minimum="1"
                        Maximum="16"
                        StepFrequency="1"
                        Value="1"
                        ValueChanged="BrushSizeSlider_ValueChanged"
                        ToolTipService.ToolTip="{x:Bind local:Texts.BrushSizeTip}" />
                    <CheckBox
                        x:Name="PixelPerfectBox"
                        Content="{x:Bind local:Texts.PixelPerfect}"
                        Click="PixelPerfect_Click"
                        ToolTipService.ToolTip="{x:Bind local:Texts.PixelPerfectTip}" />

                    <!-- ディザ（網かけ）のパターン塗り。選択肢は最初の描画のあとで足す（MainWindow.Pattern.cs） -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind local:Texts.Pattern}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="PatternBox" HorizontalAlignment="Right" MinWidth="110" SelectedIndex="0" SelectionChanged="Pattern_SelectionChanged" ToolTipService.ToolTip="{x:Bind local:Texts.PatternTip}">
                            <ComboBoxItem Content="{x:Bind local:Texts.None}" />
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="PatternGapBox" Content="{x:Bind local:Texts.PatternGap}" Visibility="Collapsed" Click="PatternGap_Click" />

                    <!-- カラーマスク（AzPainter2 のマスク／逆マスクにあたる） -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind local:Texts.ColorMask}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="MaskModeBox" HorizontalAlignment="Right" MinWidth="110" SelectedIndex="0" SelectionChanged="MaskMode_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind local:Texts.Off}" />
                            <ComboBoxItem Content="{x:Bind local:Texts.MaskProtect}" />
                            <ComboBoxItem Content="{x:Bind local:Texts.MaskOnly}" />
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <StackPanel x:Name="MaskSwatches" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />
                        <Button Content="＋" Padding="8,2" Click="MaskAdd_Click" ToolTipService.ToolTip="{x:Bind local:Texts.MaskAddTip}" />
                        <Button Content="×" Padding="8,2" Click="MaskClear_Click" ToolTipService.ToolTip="{x:Bind local:Texts.MaskClearTip}" />
                    </StackPanel>
                    </StackPanel>
                    </Border>

                    <!-- 色の段階（AzPainter2 の拡張パレットにあたる） -->
                    <Border x:Name="ShadeSlot">
                    <StackPanel x:Name="ShadeSection" Spacing="8">
                        <Grid>
                            <TextBlock Text="{x:Bind local:Texts.Shades}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="HueShiftToggle" Padding="6,4" IsChecked="True" Click="ShadeOption_Click" ToolTipService.ToolTip="{x:Bind local:Texts.HueShiftTip}">
                                    <FontIcon Glyph="&#xE790;" FontSize="12" />
                                </ToggleButton>
                                <Button Padding="6,4" Click="ShadeBaseFromCurrent_Click" ToolTipService.ToolTip="{x:Bind local:Texts.ShadeBaseTip}">
                                    <FontIcon Glyph="&#xE718;" FontSize="12" />
                                </Button>
                                <Button x:Name="ShadeDetachButton" Tag="shades" Padding="6,4" Click="PanelDetach_Click">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <win2d:CanvasControl
                            x:Name="ShadeCanvas"
                            Height="164"
                            Draw="ShadeCanvas_Draw"
                            PointerPressed="ShadeCanvas_PointerPressed"
                            PointerMoved="ShadeCanvas_PointerMoved"
                            PointerReleased="ShadeCanvas_PointerReleased"
                            ToolTipService.ToolTip="{x:Bind local:Texts.ShadeCanvasTip}" />
                    </StackPanel>
                    </Border>

                    <!-- レイヤー（上にあるレイヤーほど一覧の上に並ぶ） -->
                    <Border x:Name="LayersSlot">
                    <StackPanel x:Name="LayersSection" Spacing="8">
                        <Grid>
                            <TextBlock Text="{x:Bind local:Texts.Layers}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="LayersDetachButton" Tag="layers" HorizontalAlignment="Right" Padding="6,4" Click="PanelDetach_Click">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Width="30" Height="30" Padding="0" Click="LayerAdd_Click" ToolTipService.ToolTip="{x:Bind local:Texts.LayerAddTip}">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerDuplicate_Click" ToolTipService.ToolTip="{x:Bind local:Texts.LayerDuplicateTip}">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerUp_Click" ToolTipService.ToolTip="{x:Bind local:Texts.LayerUpTip}">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerDown_Click" ToolTipService.ToolTip="{x:Bind local:Texts.LayerDownTip}">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerMerge_Click" Content="{x:Bind local:Texts.MergeShort}" FontSize="12" ToolTipService.ToolTip="{x:Bind local:Texts.LayerMergeTip}" />
                            <Button Width="30" Height="30" Padding="0" Click="LayerDelete_Click" ToolTipService.ToolTip="{x:Bind local:Texts.Delete}">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="LayerList" Spacing="2" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LayerOpacityText" VerticalAlignment="Center" FontSize="12" Text="{x:Bind local:Texts.Opacity100}" />
                            <Slider
                                x:Name="LayerOpacitySlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Value="100"
                                ValueChanged="LayerOpacitySlider_ValueChanged" />
                        </Grid>
                    </StackPanel>
                    </Border>

                    <!-- パレット -->
                    <Border x:Name="PaletteSlot">
                    <StackPanel x:Name="PaletteSection" Spacing="8">
                    <Grid>
                        <TextBlock Text="{x:Bind local:Texts.Palette}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="PaletteDetachButton" Tag="palette" Padding="6,4" Click="PanelDetach_Click">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                            <Button Content="＋" Padding="8,2" Click="AddColor_Click" ToolTipService.ToolTip="{x:Bind local:Texts.PaletteAddTip}" />
                            <Button Content="…" Padding="8,2" ToolTipService.ToolTip="{x:Bind local:Texts.PaletteMenuTip}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="{x:Bind local:Texts.PaletteImport}" Click="ImportPalette_Click" />
                                        <MenuFlyoutItem Text="{x:Bind local:Texts.PaletteExport}" Click="ExportPalette_Click" />
                                        <MenuFlyoutItem Text="{x:Bind local:Texts.PaletteFromImage}" Click="ImportUsedColors_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{x:Bind local:Texts.PaletteReset}" Click="ResetPalette_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <VariableSizedWrapGrid
                        x:Name="PaletteGrid"
                        Orientation="Horizontal"
                        ItemWidth="27"
                        ItemHeight="27"
                        MaximumRowsOrColumns="7" />
                    <TextBlock
                        Text="{x:Bind local:Texts.AltPickHint}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Padding="12,4"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock
            x:Name="VersionText"
            Grid.Row="4"
            HorizontalAlignment="Right"
            Padding="12,4"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
