<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DotPixelPainter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="DotPixelPainter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトルバー一体型のタブ -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            CanDragTabs="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            SelectionChanged="Tabs_SelectionChanged">
            <TabView.TabStripFooter>
                <Grid x:Name="DragRegion" MinWidth="160" Background="Transparent" />
            </TabView.TabStripFooter>
        </TabView>

        <!-- ツールバー -->
        <StackPanel
            Grid.Row="1"
            Padding="8,4"
            Orientation="Horizontal"
            Spacing="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Button Content="新規" Click="New_Click" ToolTipService.ToolTip="新規 (Ctrl+N)" />
            <Button Content="開く" Click="Open_Click" ToolTipService.ToolTip="PNGを開く (Ctrl+O)" />
            <Button Content="保存" Click="Save_Click" ToolTipService.ToolTip="PNGで保存 (Ctrl+S)" />
            <AppBarSeparator />
            <Button Content="－" Click="ZoomOut_Click" ToolTipService.ToolTip="縮小" />
            <TextBlock x:Name="ZoomText" MinWidth="56" VerticalAlignment="Center" TextAlignment="Center" Text="800%" />
            <Button Content="＋" Click="ZoomIn_Click" ToolTipService.ToolTip="拡大" />
            <AppBarSeparator />
            <ToggleButton x:Name="GridToggle" Content="グリッド" IsChecked="True" Click="ViewOption_Click" ToolTipService.ToolTip="1pxグリッド線（4倍以上で表示）" />
            <ToggleButton x:Name="FlipToggle" Content="左右反転表示" Click="ViewOption_Click" ToolTipService.ToolTip="表示だけを左右反転（絵は変わらない）" />
            <AppBarSeparator />
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
        </StackPanel>

        <!-- キャンバスと等倍プレビュー -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <win2d:CanvasControl
                x:Name="Canvas"
                ClearColor="#FF2B2B2B"
                Draw="Canvas_Draw"
                PointerPressed="Canvas_PointerPressed"
                PointerMoved="Canvas_PointerMoved"
                PointerReleased="Canvas_PointerReleased"
                PointerCaptureLost="Canvas_PointerCaptureLost"
                PointerWheelChanged="Canvas_PointerWheelChanged" />

            <Border
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="プレビュー（等倍・2倍）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <win2d:CanvasControl x:Name="PreviewCanvas" Grid.Row="1" Draw="PreviewCanvas_Draw" />
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Padding="12,4"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
