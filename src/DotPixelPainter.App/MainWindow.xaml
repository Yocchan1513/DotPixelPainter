<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DotPixelPainter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="DotPixelPainter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトルバー一体型のタブ -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            CanDragTabs="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            SelectionChanged="Tabs_SelectionChanged">
            <TabView.TabStripFooter>
                <Grid x:Name="DragRegion" MinWidth="160" Background="Transparent" />
            </TabView.TabStripFooter>
        </TabView>

        <!-- ツールバー -->
        <StackPanel
            Grid.Row="1"
            Padding="8,4"
            Orientation="Horizontal"
            Spacing="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Button Content="新規" Click="New_Click" ToolTipService.ToolTip="新規 (Ctrl+N)" />
            <Button Content="開く" Click="Open_Click" ToolTipService.ToolTip="PNGを開く (Ctrl+O)" />
            <Button Content="保存" Click="Save_Click" ToolTipService.ToolTip="PNGで保存 (Ctrl+S)" />
            <AppBarSeparator />
            <Button x:Name="UndoButton" Content="元に戻す" Click="Undo_Click" IsEnabled="False" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" />
            <Button x:Name="RedoButton" Content="やり直し" Click="Redo_Click" IsEnabled="False" ToolTipService.ToolTip="やり直し (Ctrl+Y / Ctrl+Shift+Z)" />
            <AppBarSeparator />
            <Button Content="－" Click="ZoomOut_Click" ToolTipService.ToolTip="縮小" />
            <TextBlock x:Name="ZoomText" MinWidth="56" VerticalAlignment="Center" TextAlignment="Center" Text="800%" />
            <Button Content="＋" Click="ZoomIn_Click" ToolTipService.ToolTip="拡大" />
            <AppBarSeparator />
            <ToggleButton x:Name="GridToggle" Content="グリッド" IsChecked="True" Click="ViewOption_Click" ToolTipService.ToolTip="1pxグリッド線（4倍以上で表示）" />
            <ToggleButton x:Name="FlipToggle" Content="左右反転表示" Click="ViewOption_Click" ToolTipService.ToolTip="表示だけを左右反転（絵は変わらない）" />
        </StackPanel>

        <!-- ツールパネル・キャンバス・右パネル -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- ツール: 上段で道具、下段で描き方を選ぶ -->
            <Border
                x:Name="ToolPanel"
                Width="116"
                Padding="10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="ツール" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <VariableSizedWrapGrid
                        x:Name="ToolGrid"
                        Orientation="Horizontal"
                        ItemWidth="44"
                        ItemHeight="44"
                        MaximumRowsOrColumns="2" />
                    <Rectangle Height="1" Margin="0,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="描き方" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <VariableSizedWrapGrid
                        x:Name="ShapeGrid"
                        Orientation="Horizontal"
                        ItemWidth="44"
                        ItemHeight="44"
                        MaximumRowsOrColumns="2" />
                </StackPanel>
            </Border>

            <win2d:CanvasControl
                x:Name="Canvas"
                Grid.Column="1"
                ClearColor="#FF2B2B2B"
                Draw="Canvas_Draw"
                PointerPressed="Canvas_PointerPressed"
                PointerMoved="Canvas_PointerMoved"
                PointerReleased="Canvas_PointerReleased"
                PointerCaptureLost="Canvas_PointerCaptureLost"
                PointerWheelChanged="Canvas_PointerWheelChanged" />

            <Border
                Grid.Column="2"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="プレビュー（等倍・2倍）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <win2d:CanvasControl x:Name="PreviewCanvas" Grid.Row="1" Draw="PreviewCanvas_Draw" />

                    <!-- パレット -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="パレット" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button Content="＋" Padding="8,2" Click="AddColor_Click" ToolTipService.ToolTip="描画色をパレットに追加" />
                            <Button Content="…" Padding="8,2" ToolTipService.ToolTip="パレットの読み込み・書き出し">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="GIMPパレット（.gpl）を読み込む" Click="ImportPalette_Click" />
                                        <MenuFlyoutItem Text="GIMPパレット（.gpl）に書き出す" Click="ExportPalette_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="初期パレットに戻す" Click="ResetPalette_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <VariableSizedWrapGrid
                        x:Name="PaletteGrid"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        ItemWidth="27"
                        ItemHeight="27"
                        MaximumRowsOrColumns="7" />

                    <!-- 描画色 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="CurrentColorButton"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Click="CurrentColor_Click"
                            ToolTipService.ToolTip="描画色を変更" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentColorText" Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock
                                Text="Alt+クリックでスポイト"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Padding="12,4"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
