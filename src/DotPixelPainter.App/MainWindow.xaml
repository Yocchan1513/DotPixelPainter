<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DotPixelPainter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="DotPixelPainter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトルバー一体型のタブ -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            CanDragTabs="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            SelectionChanged="Tabs_SelectionChanged" />

        <!-- ツールバー -->
        <StackPanel
            Grid.Row="1"
            Padding="8,4"
            Orientation="Horizontal"
            Spacing="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Button Content="新規" Click="New_Click" ToolTipService.ToolTip="新規 (Ctrl+N)" />
            <Button Content="開く" Click="Open_Click" ToolTipService.ToolTip=".dotpix / PNG を開く (Ctrl+O)" />
            <Button Content="保存" Click="Save_Click" ToolTipService.ToolTip="上書き保存 (Ctrl+S)" />
            <Button Content="別名で保存" Click="SaveAs_Click" ToolTipService.ToolTip=".dotpix（レイヤーを残す）か PNG（1枚にまとめる）で保存 (Ctrl+Shift+S)" />
            <AppBarSeparator />
            <Button x:Name="UndoButton" Content="元に戻す" Click="Undo_Click" IsEnabled="False" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" />
            <Button x:Name="RedoButton" Content="やり直し" Click="Redo_Click" IsEnabled="False" ToolTipService.ToolTip="やり直し (Ctrl+Y / Ctrl+Shift+Z)" />
            <AppBarSeparator />
            <Button Content="－" Click="ZoomOut_Click" ToolTipService.ToolTip="縮小" />
            <TextBlock x:Name="ZoomText" MinWidth="56" VerticalAlignment="Center" TextAlignment="Center" Text="800%" />
            <Button Content="＋" Click="ZoomIn_Click" ToolTipService.ToolTip="拡大" />
            <AppBarSeparator />
            <ToggleButton x:Name="GridToggle" Content="グリッド" IsChecked="True" Click="ViewOption_Click" ToolTipService.ToolTip="1pxグリッド線（4倍以上で表示）" />
            <ToggleButton x:Name="FlipToggle" Content="左右反転" Click="ViewOption_Click" ToolTipService.ToolTip="表示だけを左右反転（絵は変わらない）" />
            <AppBarSeparator />
            <ToggleButton x:Name="SkinToggle" Content="スキン" Click="SkinToggle_Click" />
        </StackPanel>

        <!-- ツールパネル・キャンバス・右パネル -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- ツール: 縦1列の細い帯。上が道具、区切り線の下が描き方 -->
            <Border
                x:Name="ToolPanel"
                Width="49"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <!-- ウィンドウが低いときはスクロールできるようにする -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto">
                    <StackPanel Padding="7,8" Spacing="3">
                        <StackPanel x:Name="ToolGrid" Spacing="3" />
                        <Rectangle Height="1" Margin="2,5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="ShapeGrid" Spacing="3" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <win2d:CanvasControl
                x:Name="Canvas"
                Grid.Column="1"
                ClearColor="#FF2B2B2B"
                Draw="Canvas_Draw"
                PointerPressed="Canvas_PointerPressed"
                PointerMoved="Canvas_PointerMoved"
                PointerReleased="Canvas_PointerReleased"
                PointerCaptureLost="Canvas_PointerCaptureLost"
                PointerWheelChanged="Canvas_PointerWheelChanged" />

            <Border
                Grid.Column="2"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <!-- ウィンドウが低いときはスクロールできるようにする -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!--
                        パネル: 外側の Border（*Slot）が置き場所、内側の StackPanel（*Section）が中身。
                        切り離すと Section だけが別ウィンドウへ移り、Slot は隠れる。
                    -->
                    <Border x:Name="PreviewSlot">
                    <StackPanel x:Name="PreviewSection" Spacing="8">
                        <Grid>
                            <TextBlock x:Name="PreviewTitle" Text="プレビュー（等倍・2倍）" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                <Button Padding="6,4" Click="PreviewBackground_Click" ToolTipService.ToolTip="プレビューの背景（市松模様・白・黒・灰色・背景色）">
                                    <FontIcon Glyph="&#xE790;" FontSize="12" />
                                </Button>
                                <Button x:Name="PreviewDetachButton" Tag="preview" Padding="6,4" Click="PanelDetach_Click">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <win2d:CanvasControl
                            x:Name="PreviewCanvas"
                            Height="140"
                            Draw="PreviewCanvas_Draw"
                            PointerPressed="PreviewCanvas_PointerPressed"
                            PointerMoved="PreviewCanvas_PointerMoved"
                            PointerReleased="PreviewCanvas_PointerReleased"
                            DoubleTapped="PreviewCanvas_DoubleTapped" />
                        <!-- スキンモードのときだけ出す -->
                        <StackPanel x:Name="SkinOptions" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <ToggleButton x:Name="SlimToggle" Content="スリム腕" Click="SkinOption_Click" ToolTipService.ToolTip="腕の太さ: オンでスリム（3px）、オフでクラシック（4px）" />
                            <ToggleButton x:Name="OuterToggle" Content="外側" IsChecked="True" Click="SkinOption_Click" ToolTipService.ToolTip="外側のレイヤー（帽子・上着・袖・ズボン）を表示" />
                        </StackPanel>
                    </StackPanel>
                    </Border>

                    <Border x:Name="ColorSlot">
                    <StackPanel x:Name="ColorSection" Spacing="8">
                    <Grid>
                        <TextBlock Text="カラー" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Button x:Name="ColorDetachButton" Tag="color" HorizontalAlignment="Right" Padding="6,4" Click="PanelDetach_Click">
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 色: 描画色と背景色、色コード、RGB/HSV の切り替え -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="54" Height="54">
                            <Border
                                x:Name="BackColorSwatch"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Tapped="BackColor_Tapped"
                                ToolTipService.ToolTip="背景色（クリックで描画色と入れ替え X / 白黒に戻す D）" />
                            <Border
                                x:Name="ForeColorSwatch"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Tapped="ForeColor_Tapped"
                                ToolTipService.ToolTip="描画色（クリックでカラーピッカー）" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBox
                                x:Name="ColorHexBox"
                                FontFamily="Consolas"
                                MaxLength="9"
                                KeyDown="ColorHexBox_KeyDown"
                                LostFocus="ColorHexBox_LostFocus"
                                ToolTipService.ToolTip="色コード（RRGGBB または AARRGGBB）。Enter で反映" />
                            <ToggleButton
                                x:Name="HsvToggle"
                                Content="HSV"
                                Padding="10,2"
                                Click="ColorMode_Click"
                                ToolTipService.ToolTip="スライダーを RGB と HSV で切り替え" />
                        </StackPanel>
                    </Grid>

                    <!-- 色のスライダー（1枚の描画領域に4本まとめて描く） -->
                    <win2d:CanvasControl
                        x:Name="ColorBarsCanvas"
                        Height="96"
                        Draw="ColorBars_Draw"
                        PointerPressed="ColorBars_PointerPressed"
                        PointerMoved="ColorBars_PointerMoved"
                        PointerReleased="ColorBars_PointerReleased"
                        PointerCaptureLost="ColorBars_PointerCaptureLost"
                        PointerWheelChanged="ColorBars_PointerWheelChanged" />

                    <!-- ブラシ -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock x:Name="BrushSizeText" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="ブラシ 1px" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="SquareBrushToggle" Content="□" Padding="8,2" IsChecked="True" Click="BrushShape_Click" ToolTipService.ToolTip="四角いペン先" />
                            <ToggleButton x:Name="RoundBrushToggle" Content="○" Padding="8,2" Click="BrushShape_Click" ToolTipService.ToolTip="丸いペン先" />
                        </StackPanel>
                    </Grid>
                    <Slider
                        x:Name="BrushSizeSlider"
                        Minimum="1"
                        Maximum="16"
                        StepFrequency="1"
                        Value="1"
                        ValueChanged="BrushSizeSlider_ValueChanged"
                        ToolTipService.ToolTip="ペン先の大きさ（[ と ] でも変えられる）" />

                    <!-- カラーマスク（AzPainter2 のマスク／逆マスクにあたる） -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="カラーマスク" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="MaskModeBox" HorizontalAlignment="Right" MinWidth="110" SelectedIndex="0" SelectionChanged="MaskMode_SelectionChanged">
                            <ComboBoxItem Content="オフ" />
                            <ComboBoxItem Content="指定色を保護" />
                            <ComboBoxItem Content="指定色だけ" />
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <StackPanel x:Name="MaskSwatches" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />
                        <Button Content="＋" Padding="8,2" Click="MaskAdd_Click" ToolTipService.ToolTip="描画色をマスクの色に追加（8色まで。色をクリックで外す）" />
                        <Button Content="×" Padding="8,2" Click="MaskClear_Click" ToolTipService.ToolTip="マスクの色をすべて外す" />
                    </StackPanel>
                    </StackPanel>
                    </Border>

                    <!-- 色の段階（AzPainter2 の拡張パレットにあたる） -->
                    <Border x:Name="ShadeSlot">
                    <StackPanel x:Name="ShadeSection" Spacing="8">
                        <Grid>
                            <TextBlock Text="色の段階" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="HueShiftToggle" Padding="6,4" IsChecked="True" Click="ShadeOption_Click" ToolTipService.ToolTip="上の段で、影を青寄り・ハイライトを黄寄りに色相をずらす">
                                    <FontIcon Glyph="&#xE790;" FontSize="12" />
                                </ToggleButton>
                                <Button Padding="6,4" Click="ShadeBaseFromCurrent_Click" ToolTipService.ToolTip="今の描画色を基準にする">
                                    <FontIcon Glyph="&#xE718;" FontSize="12" />
                                </Button>
                                <Button x:Name="ShadeDetachButton" Tag="shades" Padding="6,4" Click="PanelDetach_Click">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <win2d:CanvasControl
                            x:Name="ShadeCanvas"
                            Height="164"
                            Draw="ShadeCanvas_Draw"
                            PointerPressed="ShadeCanvas_PointerPressed"
                            PointerMoved="ShadeCanvas_PointerMoved"
                            PointerReleased="ShadeCanvas_PointerReleased"
                            ToolTipService.ToolTip="クリックで描画色に、右クリックでパレットに追加。右の帯で基準の色相を変える" />
                    </StackPanel>
                    </Border>

                    <!-- レイヤー（上にあるレイヤーほど一覧の上に並ぶ） -->
                    <Border x:Name="LayersSlot">
                    <StackPanel x:Name="LayersSection" Spacing="8">
                        <Grid>
                            <TextBlock Text="レイヤー" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="LayersDetachButton" Tag="layers" HorizontalAlignment="Right" Padding="6,4" Click="PanelDetach_Click">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Width="30" Height="30" Padding="0" Click="LayerAdd_Click" ToolTipService.ToolTip="新しいレイヤーを上に追加">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerDuplicate_Click" ToolTipService.ToolTip="複製">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerUp_Click" ToolTipService.ToolTip="ひとつ上へ">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerDown_Click" ToolTipService.ToolTip="ひとつ下へ">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <Button Width="30" Height="30" Padding="0" Click="LayerMerge_Click" Content="結" FontSize="12" ToolTipService.ToolTip="下のレイヤーと結合" />
                            <Button Width="30" Height="30" Padding="0" Click="LayerDelete_Click" ToolTipService.ToolTip="削除">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="LayerList" Spacing="2" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LayerOpacityText" VerticalAlignment="Center" FontSize="12" Text="不透明度 100%" />
                            <Slider
                                x:Name="LayerOpacitySlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Value="100"
                                ValueChanged="LayerOpacitySlider_ValueChanged" />
                        </Grid>
                    </StackPanel>
                    </Border>

                    <!-- パレット -->
                    <Border x:Name="PaletteSlot">
                    <StackPanel x:Name="PaletteSection" Spacing="8">
                    <Grid>
                        <TextBlock Text="パレット" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="PaletteDetachButton" Tag="palette" Padding="6,4" Click="PanelDetach_Click">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                            <Button Content="＋" Padding="8,2" Click="AddColor_Click" ToolTipService.ToolTip="描画色をパレットに追加" />
                            <Button Content="…" Padding="8,2" ToolTipService.ToolTip="パレットの読み込み・書き出し">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="GIMPパレット（.gpl）を読み込む" Click="ImportPalette_Click" />
                                        <MenuFlyoutItem Text="GIMPパレット（.gpl）に書き出す" Click="ExportPalette_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="初期パレットに戻す" Click="ResetPalette_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <VariableSizedWrapGrid
                        x:Name="PaletteGrid"
                        Orientation="Horizontal"
                        ItemWidth="27"
                        ItemHeight="27"
                        MaximumRowsOrColumns="7" />
                    <TextBlock
                        Text="Alt+クリックでスポイト"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Padding="12,4"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
