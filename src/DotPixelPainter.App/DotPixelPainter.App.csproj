<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>DotPixelPainter</RootNamespace>
    <AssemblyName>DotPixelPainter</AssemblyName>
    <!-- アプリの版。ステータスバーの右下に出す。上げたらリポジトリ直下の latest-version.txt も同じにする -->
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe のアイコン。元の絵は リポジトリ直下の icon/ にある -->
    <ApplicationIcon>Assets\DotPixelPainter.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- インストール不要の単体アプリとして動かす -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- 発行時にアプリのリソース（.pri）を出力へ含める -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 同梱する翻訳リソースを日本語と英語だけにする -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 入り口（Main）は Program.cs に自前で書く（すでに開いているアプリにファイルを送るため） -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Win32 API の呼び出し（LibraryImport）に必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 起動を速くするため、配布ビルドは Native AOT で事前コンパイルする -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <!-- まとめパッケージ（Microsoft.WindowsAppSDK）は AI・検索などを含み重いので、WinUI 本体だけを参照する -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 が要求する 2.1.8 は公開されていないため、実在する 2.1.9 を明示する -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <!--
    軽量版（-p:WindowsAppSDKSelfContained=false）だけ: Windows App SDK を同梱せず、PC に入っている
    Windows App Runtime 2.5 を使う。版は まとめパッケージ 2.5.1 が WinUI 2.3.9 と組み合わせているものに合わせる。
  -->
  <ItemGroup Condition="'$(WindowsAppSDKSelfContained)' == 'false'">
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotPixelPainter.Core\DotPixelPainter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ウィンドウ（タイトルバー・タスクバー）のアイコン用に、出力先へコピーする -->
    <Content Include="Assets\DotPixelPainter.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\DotPixelPainter-192.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    発行（publish）するときに、エクスプローラー用のサムネイルの部品（DotPixelPainter.Thumbnail.dll）も同じフォルダに出す。
    Native AOT の DLL なので、アプリと同じ RID で発行する。
  -->
  <Target Name="PublishThumbnailProvider" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <PropertyGroup>
      <_ThumbnailProject>$(MSBuildThisFileDirectory)..\DotPixelPainter.Thumbnail\DotPixelPainter.Thumbnail.csproj</_ThumbnailProject>
      <_ThumbnailProperties>Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(PublishDir)</_ThumbnailProperties>
      <_ThumbnailRemove>Platform;WindowsAppSDKSelfContained;SelfContained;PublishReadyToRun;PublishTrimmed;PublishAot</_ThumbnailRemove>
    </PropertyGroup>
    <!-- 復元（restore）は別の呼び出しで先に済ませる -->
    <MSBuild Projects="$(_ThumbnailProject)" Targets="Restore" Properties="$(_ThumbnailProperties);_ThumbnailRestore=true" RemoveProperties="$(_ThumbnailRemove)" />
    <MSBuild Projects="$(_ThumbnailProject)" Targets="Publish" Properties="$(_ThumbnailProperties)" RemoveProperties="$(_ThumbnailRemove)" />
    <Delete Files="$(PublishDir)DotPixelPainter.Thumbnail.pdb" />
  </Target>

  <ItemGroup>
    <!-- 画面の文字は T("日本語", "English") で書く（Lang.cs） -->
    <Using Include="DotPixelPainter.Core.Lang" Static="true" />
  </ItemGroup>

</Project>
