<Project Sdk="Microsoft.NET.Sdk">

  <!--
    エクスプローラーで .dotpix の中身の絵を出すための部品（サムネイルプロバイダー）。
    Native AOT でネイティブの DLL にして、エクスプローラーが COM として読み込む。
    アプリを発行（publish）すると、アプリと同じフォルダに一緒に出力される（DotPixelPainter.App.csproj）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotPixelPainter.Core\DotPixelPainter.Core.csproj" />
  </ItemGroup>

</Project>
